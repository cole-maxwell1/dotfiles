{
  "$schema": "https://opencode.ai/config.json",
  "permissions": [
    { "action": "shell", "resource": "*", "effect": "ask" },
    // Git
    { "action": "shell", "resource": "git log *", "effect": "allow" },
    { "action": "shell", "resource": "git commit *", "effect": "ask" },
    { "action": "shell", "resource": "git status *", "effect": "allow" },
    { "action": "shell", "resource": "git diff *", "effect": "allow" },
    { "action": "shell", "resource": "git show *", "effect": "allow" },
    { "action": "shell", "resource": "git push *", "effect": "ask" },
    // Privilege escalation
    { "action": "shell", "resource": "sudo *", "effect": "deny" },
    { "action": "shell", "resource": "su *", "effect": "deny" },
    { "action": "shell", "resource": "doas *", "effect": "deny" },
    // GNU Util
    { "action": "shell", "resource": "curl *", "effect": "ask" },
    { "action": "shell", "resource": "wget *", "effect": "ask" },
    { "action": "shell", "resource": "diff *", "effect": "allow" },
    { "action": "shell", "resource": "rm *", "effect": "ask" },
    { "action": "shell", "resource": "rm -rf *", "effect": "deny" },
    { "action": "shell", "resource": "sort *", "effect": "allow" },
    { "action": "shell", "resource": "which *", "effect": "allow" },
    { "action": "shell", "resource": "ls *", "effect": "allow" },
    { "action": "shell", "resource": "wc *", "effect": "allow" },
    { "action": "shell", "resource": "head *", "effect": "allow" },
    { "action": "shell", "resource": "tail *", "effect": "allow" },
    // Go
    { "action": "shell", "resource": "go build *", "effect": "allow" },
    { "action": "shell", "resource": "go test *", "effect": "allow" },
    { "action": "shell", "resource": "go vet *", "effect": "allow" },
    { "action": "shell", "resource": "go mod tidy", "effect": "allow" },
    { "action": "shell", "resource": "go mod download", "effect": "allow" },
    { "action": "shell", "resource": "gofmt *", "effect": "allow" },
    // Node.js
    { "action": "shell", "resource": "npm ci", "effect": "allow" },
    { "action": "shell", "resource": "npm test", "effect": "allow" },
    { "action": "shell", "resource": "npm run build", "effect": "allow" },
    { "action": "shell", "resource": "npm run lint", "effect": "allow" },
    { "action": "shell", "resource": "npm run typecheck", "effect": "allow" },
    { "action": "shell", "resource": "npm run check", "effect": "allow" },
    { "action": "shell", "resource": "npm ls *", "effect": "allow" },
    { "action": "shell", "resource": "npm outdated", "effect": "allow" },
    { "action": "shell", "resource": "npm audit *", "effect": "allow" },
    { "action": "shell", "resource": "npm run test:*", "effect": "allow" },
    { "action": "shell", "resource": "npm run build-only", "effect": "allow" },
    { "action": "shell", "resource": "npm run type-check", "effect": "allow" },
    { "action": "shell", "resource": "npm run package:dev", "effect": "allow" },
    { "action": "shell", "resource": "npx vitest run *", "effect": "allow" },
    { "action": "shell", "resource": "npx *", "effect": "ask" },
    // Python
    {
      "action": "shell",
      "resource": "python -m unittest *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "python -m py_compile",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "python3 -m unittest *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "python3 -m py_compile",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "python -m venv .venv",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "python3 -m venv .venv",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "source .venv/bin/activate",
      "effect": "allow",
    },
    { "action": "shell", "resource": "ruff check *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "ruff format --check *",
      "effect": "allow",
    },
    { "action": "shell", "resource": "ruff format *", "effect": "ask" },
    // Dotnet
    { "action": "shell", "resource": "dotnet build *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet test *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet restore *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet format *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet vet *", "effect": "allow" },
    { "action": "shell", "resource": "dotnet workload *", "effect": "ask" },
    { "action": "shell", "resource": "dotnet run *", "effect": "allow" },
    // Docker
    { "action": "shell", "resource": "docker ps *", "effect": "allow" },
    { "action": "shell", "resource": "docker logs *", "effect": "allow" },
    {
      "action": "shell",
      "resource": "docker compose logs *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "docker manifest inspect",
      "effect": "allow",
    },
    // Ansible
    {
      "action": "shell",
      "resource": "ansible-playbook --version",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "ansible-playbook --syntax-check *",
      "effect": "allow",
    },
    {
      "action": "shell",
      "resource": "ansible-lint --version",
      "effect": "allow",
    },
    // OpenTofu
    { "action": "shell", "resource": "tofu version", "effect": "allow" },
    {
      "action": "shell",
      "resource": "tofu init -backend=false",
      "effect": "allow",
    },
    { "action": "shell", "resource": "tofu validate *", "effect": "allow" },
    { "action": "shell", "resource": "tofu fmt -check *", "effect": "allow" },
    { "action": "shell", "resource": "tofu plan *", "effect": "allow" },
    { "action": "read", "resource": "/tmp/opencode", "effect": "allow" },
    { "action": "read", "resource": "/tmp/opencode/*", "effect": "allow" },
    { "action": "read", "resource": "~/.ssh/known_hosts", "effect": "allow" },
    // Env / secrets — recursive + variants
    { "action": "read", "resource": ".env", "effect": "deny" },
    { "action": "read", "resource": ".env.*", "effect": "deny" },
    { "action": "read", "resource": "**/.env", "effect": "deny" },
    { "action": "read", "resource": "**/.env.*", "effect": "deny" },
    { "action": "read", "resource": ".secrets", "effect": "deny" },
    { "action": "read", "resource": "**/.secrets", "effect": "deny" },
    { "action": "read", "resource": ".secrets.*", "effect": "deny" },
    { "action": "read", "resource": "~/.odbc.ini", "effect": "deny" },
    // Key material
    { "action": "read", "resource": "*.key", "effect": "deny" },
    { "action": "read", "resource": "*.pem", "effect": "deny" },
    { "action": "read", "resource": "*.p12", "effect": "deny" },
    { "action": "read", "resource": "*.pfx", "effect": "deny" },
    { "action": "read", "resource": "*.keystore", "effect": "deny" },
    { "action": "read", "resource": "*.jks", "effect": "deny" },
    { "action": "read", "resource": "*.kdbx", "effect": "deny" }, // KeePass
    // SSH keys — all algorithms incl. FIDO
    { "action": "read", "resource": "id_rsa", "effect": "deny" },
    { "action": "read", "resource": "id_ecdsa", "effect": "deny" },
    { "action": "read", "resource": "id_ed25519", "effect": "deny" },
    { "action": "read", "resource": "id_dsa", "effect": "deny" },
    { "action": "read", "resource": "id_ecdsa_sk", "effect": "deny" },
    { "action": "read", "resource": "id_ed25519_sk", "effect": "deny" },
    { "action": "read", "resource": "~/.ssh/id_*", "effect": "deny" }, // catch-all absolute
    { "action": "read", "resource": "~/.ssh/config", "effect": "deny" }, // may contain HostName + IdentityFile
    // Cloud / service credentials
    { "action": "read", "resource": ".aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/credentials", "effect": "deny" },
    { "action": "read", "resource": "~/.aws/config", "effect": "deny" },
    { "action": "read", "resource": "~/.config/gcloud/*", "effect": "deny" },
    { "action": "read", "resource": "~/.kube/config", "effect": "deny" },
    { "action": "read", "resource": "~/.npmrc", "effect": "deny" }, // often contains _authToken
    { "action": "read", "resource": "~/.pypirc", "effect": "deny" },
    { "action": "read", "resource": "~/.netrc", "effect": "deny" },
    { "action": "read", "resource": "~/.docker/config.json", "effect": "deny" },
    // Misc
    { "action": "read", "resource": ".npmrc", "effect": "deny" }, // project-local tokens
    { "action": "read", "resource": "**/.npmrc", "effect": "deny" },
    { "action": "edit", "resource": "/tmp/opencode", "effect": "allow" },
    { "action": "edit", "resource": "/tmp/opencode/*", "effect": "allow" },
    // Explicit deny for dotfiles reduces accidental writes
    { "action": "edit", "resource": ".env*", "effect": "deny" },
    { "action": "edit", "resource": ".git/*", "effect": "deny" },
    { "action": "edit", "resource": "**/.git/*", "effect": "deny" },
    { "action": "edit", "resource": ".hooks/*", "effect": "ask" }, // git hook injection
    { "action": "grep", "resource": "*", "effect": "allow" },
    { "action": "glob", "resource": "*", "effect": "allow" },
    { "action": "question", "resource": "*", "effect": "allow" },
    { "action": "lsp", "resource": "*", "effect": "allow" },
    { "action": "websearch", "resource": "*", "effect": "allow" },
    { "action": "webfetch", "resource": "*", "effect": "allow" },
    { "action": "subagent", "resource": "*", "effect": "allow" },
    { "action": "todowrite", "resource": "*", "effect": "allow" },
    { "action": "skill", "resource": "*", "effect": "allow" },
    // V1 asked before accessing paths outside the project.
    { "action": "external_directory", "resource": "*", "effect": "ask" },
  ],
  "mcp": {
    "servers": {
      "zai-mcp-server": {
        "type": "local",
        "command": ["npx", "-y", "@z_ai/mcp-server"],
        "environment": {
          "Z_AI_API_KEY": "{env:ZAI_API_KEY}",
          "Z_AI_MODE": "ZAI",
        },
      },
      "web-search-prime": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/web_search_prime/mcp",
        "headers": {
          "Authorization": "Bearer {env:ZAI_API_KEY}",
        },
      },
      "web-reader": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/web_reader/mcp",
        "headers": {
          "Authorization": "Bearer {env:ZAI_API_KEY}",
        },
      },
      "zread": {
        "type": "remote",
        "url": "https://api.z.ai/api/mcp/zread/mcp",
        "headers": {
          "Authorization": "Bearer {env:ZAI_API_KEY}",
        },
      },
      "playwright": {
        "type": "local",
        "disabled": false,
        "command": ["npx", "@playwright/mcp@latest"],
      },
      "chrome-devtools": {
        "type": "local",
        "disabled": false,
        "command": [
          "npx",
          "-y",
          "chrome-devtools-mcp@latest",
          "--executablePath",
          "/usr/bin/chromium",
        ],
      },
      "primevue": {
        "type": "local",
        "disabled": false,
        "command": ["npx", "-y", "@primevue/mcp"],
      },
      "ibmi-server": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@ibm/ibmi-mcp-server@latest",
          "--builtin-tools",
          "--tools",
          "{env:HOME}/.config/opencode/mcp/ibmi-mcp-server/tools",
        ],
        "disabled": true,
        "environment": {
          "DB2i_HOST": "{env:DB2i_HOST}",
          "DB2i_USER": "{env:DB2i_USER}",
          "DB2i_PASS": "{env:DB2i_PASS}",
          "DB2i_PORT": "8076",
          "YAML_ALLOW_DUPLICATE_SOURCES": "true",
          "SELECTED_TOOLSETS": "catalog",
        },
      },
    },
  },
  "watcher": {
    "ignore": [
      "node_modules/**",
      ".git/**",
      "dist/**",
      "**/.venv/**",
      "**/target/**",
    ],
  },
  "lsp": true,
  "formatter": true,
  "model": "openai/gpt-5.6-sol",
  "agents": {
    "explore": {
      "model": "openai/gpt-5.6-luna",
    },
    "title": {
      "model": "openai/gpt-5.6-luna",
    },
  },
  "share": "disabled",
  "snapshots": true,
  "plugins": ["@slkiser/opencode-quota@latest"],
  "providers": {
    "zai": {},
    "openai": {},
  },
  "experimental": {
    "todo": true,
  },
}
